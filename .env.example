# Configuración del Entorno - Smile Aesthetic & Dental Clinic
APP_NAME="Smile Aesthetic & Dental Clinic - Agendador IA"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Gemini API Key y Modelos (Requerido para la IA)
# Usar variantes "Lite" para cuota gratuita alta (~500 solicitudes/día) sin necesidad de plan pago.
# El modelo NUNCA debe hardcodearse en el código: siempre se lee desde estas variables.
GEMINI_API_KEY="TU_GEMINI_API_KEY_AQUI"
GEMINI_MODEL="gemini-2.5-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-2.0-flash-lite"

# Base de Datos
DATABASE_URL="sqlite+aiosqlite:///./data/smile_clinic.db"

# WhatsApp Business API / Webhook (Opcional para pruebas en vivo)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="kinexus_smile_verify_token"

# n8n Webhook URL (Si se utiliza la orquestación n8n)
N8N_WEBHOOK_URL="http://localhost:5678/webhook/appointment"
